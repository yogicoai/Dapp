# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 템플릿은 값이 비어 있으므로 커밋한다. 필요한 키 목록이 저장소에 남아야 한다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# UI 에셋 원본 PNG 보관용 (배포는 public/의 webp만 쓴다)
/originals-png/
.bake-patjuk.mjs
.upload-patjuk.mjs
.apply-patjuk-boxes.mjs
.bake-tortoise-narr.mjs
.bake-tortoise-char.mjs
.build-jack.mjs
.upload-jack.mjs
.bake-jack.mjs
.bake-jack-hotspots.mjs
tmp-stories/

.dev-server.log
.dev-server.log.err

# 대외비 문서(클라이언트 가격 권고안 등) — 저장소에 올리지 않는다
/*.pdf

# 대외비 PDF 는 어느 폴더에 있어도 올리지 않는다(10-20 — public/ 의 KG 계약 매뉴얼이 루트 규칙에 안 걸렸다)
*.pdf
# 앱 서명 키 — 절대 저장소에 넣지 않는다(안드로이드 시험판 10-20)
*.keystore
*.jks
*.p12
