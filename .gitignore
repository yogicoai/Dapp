# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 템플릿은 값이 비어 있으므로 커밋한다. 필요한 키 목록이 저장소에 남아야 한다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# UI 에셋 원본 PNG 보관용 (배포는 public/의 webp만 쓴다)
/originals-png/
.bake-patjuk.mjs
.upload-patjuk.mjs
.apply-patjuk-boxes.mjs
.bake-tortoise-narr.mjs
.bake-tortoise-char.mjs
