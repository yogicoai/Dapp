# 이 파일을 .env.local로 복사한 뒤 값을 채운다. 여기에는 절대 실제 키를 넣지 말 것.
#   cp .env.example .env.local

# ── 스토리 생성 (Claude) ──────────────────────────────────────────
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# 베타는 토큰 비용 때문에 sonnet-5로 간다(사장님 결정, 2026-07-31).
# 품질이 더 필요하면 claude-opus-5로 올릴 수 있지만 권당 원가가 몇 배가 된다.
ANTHROPIC_MODEL=claude-sonnet-5

# ── 삽화 생성 (Gemini) ────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 4:3 가로. 태블릿 전체화면에 맞추기 위한 것이며 Gemini가 네이티브로 지원하는 비율이다.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── 힉스필드 (디자인 연출용) ──────────────────────────────────────
# 앱의 동화적 비주얼 방향을 잡는 데 쓴다. 런타임 삽화 생성은 Gemini다.
# platform.higgsfield.ai — 인증은 Key {키}:{시크릿} 형식.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# ── DB · 스토리지 · 인증 (Supabase) ───────────────────────────────
# https://supabase.com — 리전은 반드시 Seoul(ap-northeast-2). 나중에 못 바꾼다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 절대 클라이언트에 노출하지 말 것. 서버 라우트에서만 쓴다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 음성 (Typecast) ───────────────────────────────────────────────
# 성우 낭독 + 부모 목소리 클로닝(퀵 클론). 반드시 "API 플랜"(라이트 $15) 키여야 한다 —
# 스튜디오 플랜(베이직) 키는 API가 막혀 있다. 배포처(Vercel)에도 넣어야 폰에서 성우가 나온다.
TYPECAST_API_KEY=

# 그림 생성 엔진 — gemini(기본) 또는 openai. openai면 아래 OPENAI_* 를 쓴다.
IMAGE_PROVIDER=gemini
# OpenAI 그림(gpt-image-1). 키는 .env.local 에만.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# low · medium · high — medium 이 값과 결의 중간(장당 약 60~100원).
OPENAI_IMAGE_QUALITY=medium

# ── 결제 시연 ── on(기본)=시연 결제 화면, off="결제는 곧 열려요". 빌드 때 박히는 값이라 바꾸면 다시 배포.
NEXT_PUBLIC_PAY_DEMO=on
