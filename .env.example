# 이 파일을 .env.local로 복사한 뒤 값을 채운다. 여기에는 절대 실제 키를 넣지 말 것.
#   cp .env.example .env.local

# ── 스토리 생성 (Claude) ──────────────────────────────────────────
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# 권당 텍스트 원가는 약 ₩67로, 권당 총원가 ₩620의 11%뿐이다(이미지가 80%).
# 원가가 정말 문제가 되면 claude-sonnet-5로 낮출 수 있지만 ₩27 차이다.
ANTHROPIC_MODEL=claude-opus-4-8

# ── 삽화 생성 (Gemini) ────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 4:3 가로. 태블릿 전체화면에 맞추기 위한 것이며 Gemini가 네이티브로 지원하는 비율이다.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── DB · 스토리지 · 인증 (Supabase) ───────────────────────────────
# https://supabase.com — 리전은 반드시 Seoul(ap-northeast-2). 나중에 못 바꾼다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 절대 클라이언트에 노출하지 말 것. 서버 라우트에서만 쓴다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 음성 (Typecast) ───────────────────────────────────────────────
# 프리셋 낭독과 부모 목소리 클로닝. 아직 미사용.
TYPECAST_API_KEY=
